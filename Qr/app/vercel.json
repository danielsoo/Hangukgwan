{
  "buildCommand": "node scripts/build-site.js",
  "outputDirectory": "site",
  "functions": {
    "api/index.js": {
      "includeFiles": "{public,site}/**",
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/:page(about|account|group|login|menu|signup|visit)/", "destination": "/:page/index.html" },
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    {
      "path": "/api/settlements/cron-close",
      "schedule": "0 15 * * *"
    }
  ]
}
