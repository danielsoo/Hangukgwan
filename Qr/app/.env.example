# Copy this file to .env and fill in your own values before deploying.

# REQUIRED. MongoDB Atlas connection string — this is where all menu,
# order, table, and photo data lives. Create a free cluster at
# https://www.mongodb.com/cloud/atlas, then Database > Connect > Drivers
# to get this URL (it looks like mongodb+srv://user:pass@cluster.../).
MONGODB_URI=

# Optional — database name inside your Atlas cluster (default: hangukgwan)
MONGODB_DB=hangukgwan

# Port the server listens on (Railway/Render set this automatically;
# ignored entirely on Vercel)
PORT=3000

# Admin dashboard login password (used only the very first time the app
# starts to create the admin account — after that, change it from
# Admin > Settings and this value is ignored).
ADMIN_PASSWORD=changeme123

# 직원용 로그인 비밀번호 (ADMIN_PASSWORD와 같은 방식 — 최초 1회만 쓰이고
# 이후에는 Admin > 설정에서 바꾼 값이 우선). 사장 비밀번호로 로그인하면
# 전체 권한, 직원 비밀번호로 로그인하면 사장이 켜둔 권한만.
STAFF_PASSWORD=staff1234

# Random long string used to sign session cookies. Change this to any
# random text before deploying publicly.
SESSION_SECRET=please-change-this-to-a-long-random-string

# 홈페이지 통합 로그인에서 "사장" 역할을 자동으로 받을 이메일 주소
# (쉼표로 여러 개 가능). 손님·직원·사장이 전부 같은 화면에서 로그인하고
# 역할만 다른 구조라(src/accounts.js), 맨 처음 사장 계정을 누가 만들어
# 주느냐는 닭-달걀 문제가 생긴다 — 여기에 적어둔 주소로 가입하면 그
# 계정이 곧바로 사장이 되고, 그 뒤로는 Admin 화면에서 다른 계정을
# 직원/사장으로 올려줄 수 있다.
#
# 비워둬도 된다: 기존 비밀번호 로그인(위 ADMIN_PASSWORD)이 그대로 살아
# 있어서 그걸로 관리자 화면에 들어간 뒤 본인 계정을 사장으로 지정하면 된다.
OWNER_EMAIL=

# 구글 로그인(Firebase) — 손님과 관리자가 "구글로 계속하기"로 로그인할 수
# 있게 해준다. 이 값이 없으면 홈페이지에 구글 버튼이 아예 안 뜨고
# 이메일+비밀번호 로그인만 동작한다(기존 VIP 회원 기능도 동일).
# Firebase Console > 프로젝트 설정 > 서비스 계정 > "새 비공개 키 생성"으로
# 받은 JSON 파일 내용 전체를 한 줄 문자열로 넣는다.
FIREBASE_SERVICE_ACCOUNT=

# Restaurant info shown on the customer menu footer
STORE_NAME_ZH=韓國館
STORE_NAME_KO=한국관
STORE_NAME_EN=Hangukgwan Korean Restaurant
STORE_PHONE=03-656-7994
STORE_ADDRESS_ZH=新竹縣竹北市縣政九路135巷32號
STORE_HOURS=11:00-14:00, 17:00-21:00
STORE_MIN_SPEND=200

# How many tables to create the very first time the app starts
# (you can add/remove tables anytime from Admin > Tables afterwards)
DEFAULT_TABLE_COUNT=40

# Online payment (ECPay 綠界) — lets customers pay their table's bill
# themselves via credit card / LINE Pay / JKOPay / convenience-store code.
# Turn the feature on/off from Admin > 설정 > 온라인 결제 (owner only); these
# three values here are what make it actually charge real money.
#
# Leave all three blank to run in TEST MODE: payments use ECPay's public
# sandbox (fake cards, no real money) so you can try the whole flow before
# signing up. To go live, apply for an ECPay merchant account at
# https://www.ecpay.com.tw (requires a Taiwan business registration + bank
# account), then paste the MerchantID/HashKey/HashIV they issue you here.
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=

# 주문 실시간 알림 (Pusher Channels) — 관리자 화면이 새 주문을 폴링
# 없이(또는 아주 느린 안전망 폴링만으로) 즉시 받게 해준다. 자세한 배경과
# 설정 방법은 프로젝트 문서 realtime-orders-setup.md 참고.
#
# 네 값 다 채워야만 켜지고, 하나라도 비어 있으면 기존처럼 2초 폴링만
# 쓴다(안전한 기본값) — https://dashboard.pusher.com 에서 Channels 앱을
# 만들고 "App Keys" 탭에서 확인. Vercel에 배포할 때는 여기 말고 Vercel
# 프로젝트의 Settings > Environment Variables에 똑같이 4개를 넣어야 한다
# (이 .env 파일은 로컬 실행에만 쓰이고 배포에는 반영되지 않음).
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
